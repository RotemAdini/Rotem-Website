# Sanity — copy this file to .env.local and fill in the real values.
# .env.local is git-ignored; never commit a token.

# Your Sanity project id (Sanity dashboard -> project -> settings).
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name. "production" unless you deliberately made another one.
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API date. Changing it changes query behaviour — only bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-07

# Write token, used ONLY by scripts/import-to-sanity.ts from the command line.
# Create it at: Sanity dashboard -> API -> Tokens -> Add token -> Editor.
# Not prefixed with NEXT_PUBLIC_ so it can never reach the browser bundle.
SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Supabase — auth + favourites. Not active yet; see docs/supabase-favorites-migration.md
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser: it grants nothing
# on its own, and every table is gated by Row Level Security.
# The older "anon" key is accepted too, via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# The site's own public origin, e.g. https://rotem-adini.com — no trailing
# slash, no path. REQUIRED in every deployed environment: the OAuth callback
# builds its redirect on this instead of on the incoming request's Host header,
# which a client can forge. Locally, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Secret / service-role key (sb_secret_...). REQUIRED only once payments are
# live: it is the sole way a purchase or entitlement row can be written, because
# those tables have no insert policy for any normal role. It bypasses Row Level
# Security entirely, so it must never carry a NEXT_PUBLIC_ prefix and must only
# be read from a module marked "server-only" (see lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=
